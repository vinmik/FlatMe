# Leave EXPO_PUBLIC_API_URL empty to run against the built-in mock backend (great for UI work).
# Point it at the deployed Function App to use the real API, e.g. https://func-flatme-xyz.azurewebsites.net/api
EXPO_PUBLIC_API_URL=

# Optional Android Google Maps SDK key (restrict it to package com.flatme.app + your signing SHA-1).
# Without it, Android shows the built-in stylised map instead of Google Maps. Re-run `expo prebuild` after setting.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

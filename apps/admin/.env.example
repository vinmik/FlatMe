# Base URL of the FlatMe API (Azure Functions), including the /api prefix.
# Leave empty to run the portal against the built-in in-memory mock backend.
VITE_API_BASE_URL=

# Force the in-memory mock backend even when VITE_API_BASE_URL is set ("true" / "false").
VITE_USE_MOCKS=true

# TEMPORARY: run the portal without sign-in ("true" / "false"). No login screen, no bearer token,
# no automatic sign-out. Must match the API's ADMIN_AUTH_DISABLED=true. Production builds default
# to "true" when this is unset (see vite.config.ts); set "false" to turn OTP sign-in back on.
VITE_ADMIN_AUTH_DISABLED=true
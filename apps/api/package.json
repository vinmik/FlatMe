{
  "name": "@flatme/api",
  "version": "0.1.0",
  "private": true,
  "description": "FlatMe HTTP API (Azure Functions v4, Node 22)",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && func start",
    "package": "npm run build && node scripts/package.mjs",
    "storage": "node scripts/local-storage.mjs",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/cosmos": "^4.10.2",
    "@azure/functions": "^4.17.1",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@flatme/shared": "^0.1.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "azure-functions-core-tools": "^4.16.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
